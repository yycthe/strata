rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Live application reads and writes run through the server with the
    // Firebase Admin SDK. Client-side Firestore access is not required for
    // the production workflow, so direct browser access is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
